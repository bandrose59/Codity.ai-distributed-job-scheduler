# Local development environment.
# Copy this file to .env and adjust values if needed.

NODE_ENV=development
API_PORT=3000

DATABASE_URL=postgresql://scheduler:scheduler@localhost:15432/job_scheduler?schema=public
JWT_SECRET=development-only-secret-change-me-32-characters
JWT_ACCESS_TOKEN_EXPIRES_IN=1h
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:9092
WORKER_ID=
WORKER_CONCURRENCY=10
HEARTBEAT_INTERVAL_MS=10000
JOB_LEASE_MS=60000
POLL_INTERVAL_MS=1000
SHUTDOWN_TIMEOUT_MS=30000
SCHEDULER_ID=
SCHEDULER_POLL_INTERVAL_MS=1000
SCHEDULER_BATCH_SIZE=100
SCHEDULER_SHUTDOWN_TIMEOUT_MS=30000
SCHEDULER_HEARTBEAT_INTERVAL_MS=10000
API_RATE_LIMIT_PER_MINUTE=600
AUTH_RATE_LIMIT_PER_MINUTE=20
JOB_CREATE_RATE_LIMIT_PER_MINUTE=120
BATCH_CREATE_RATE_LIMIT_PER_MINUTE=30
API_BODY_LIMIT_BYTES=1000000
API_REQUEST_TIMEOUT_MS=30000
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
